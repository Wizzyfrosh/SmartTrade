# Public API origin used by the Expo client (safe to expose)
EXPO_PUBLIC_API_URL=https://smarttrade-inventotryapp.vercel.app
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only Vercel environment variables
BETTER_AUTH_URL=https://smarttrade-inventotryapp.vercel.app
BETTER_AUTH_DATABASE_URL=postgresql://<smarttrade_auth-role-connection-string>
SMARTTRADE_DATABASE_URL=postgresql://<smarttrade_app-role-connection-string>
BETTER_AUTH_SECRET=<generate-a-32-byte-or-longer-random-secret>

# Optional Google OAuth; configure matching redirect URI in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated trusted web origins
BETTER_AUTH_TRUSTED_ORIGINS=

# Server-only Neon private object storage (S3-compatible)
AWS_ACCESS_KEY_ID=<branch-scoped-neon-storage-credential-id>
AWS_SECRET_ACCESS_KEY=<branch-scoped-neon-storage-secret>
AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
AWS_REGION=eu-central-1
SMARTTRADE_STORAGE_BUCKET=smarttrade-private
